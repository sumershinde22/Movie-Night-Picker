# Copy this file to backend/.env and fill in your own values.
# Never commit the real .env — it is gitignored for a reason.

# MongoDB connection string, e.g. from a free MongoDB Atlas cluster.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Database to use inside that cluster.
DB_NAME=movie_night

# Any long random string. Signs the login session cookie.
SESSION_SECRET=change_me_to_a_long_random_string

# Port the API listens on. Defaults to 4000 when unset.
PORT=4000

# Optional. Enables the movie search that auto-fills title, genre and runtime,
# and is required by `npm run seed`. Get a free key at
# https://www.themoviedb.org/settings/api — either the v3 API key or the v4
# Read Access Token works. Without it the app still runs and every field can be
# typed in by hand.
TMDB_API_KEY=
